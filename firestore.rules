rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile and subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /trades/{tradeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /missedTrades/{missedTradeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /dailyNotes/{noteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /playbook/{ruleId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /subscription/{subscriptionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Subscriptions may be written by user initialization or restricted
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
